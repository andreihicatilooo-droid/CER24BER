# ============================================================
#  CERBER Telegram Bot — файл конфигурации (шаблон)
#  Скопируйте как .env и заполните обязательные значения.
# ============================================================

# ---- Telegram Bot (обязательно) ----
BOT_TOKEN=your_bot_token_from_botfather

# ---- CEER Bot (игровой бот, опционально) ----
# Если не задан — CEER Bot не запускается.
CEER_BOT_TOKEN=your_ceer_bot_token_from_botfather
GAME_MIN_BET=1.00
GAME_MAX_BET=100.00

# ---- База данных ----
DATABASE_URL=sqlite+aiosqlite:///./data/cerber.db
# Для PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/cerber

# ---- Стартовое изображение и поддержка ----
START_IMAGE_PATH=START.jpg
SUPPORT_URL=https://t.me/your_support_account

# ---- Общие настройки ----
REQUEST_TIMEOUT_SECONDS=15
CATALOG_CACHE_TTL=120
WALLET_CURRENCY=RUB

# ---- Модераторы (Telegram ID через запятую) ----
# MODERATOR_IDS=123456789,987654321

# ---- NicePay: пополнение баланса ----
NICEPAY_BASE_URL=https://nicepay.io
# Прокси только для запросов к NicePay (например, socks5://127.0.0.1:1080)
NICEPAY_PROXY=
NICEPAY_MERCHANT_ID=your_merchant_id
NICEPAY_SECRET=your_nicepay_secret
NICEPAY_METHOD=
NICEPAY_SUCCESS_URL=
NICEPAY_FAIL_URL=
NICEPAY_WEBHOOK_HOST=0.0.0.0
NICEPAY_WEBHOOK_PORT=8080
NICEPAY_WEBHOOK_PATH=/webhooks/nicepay

PAYMENTS_CURRENCY=RUB
PAYMENTS_TITLE=CERBER wallet top-up
PAYMENTS_DESCRIPTION=Top up your CERBER wallet to buy digital goods.
PAYMENTS_MIN_AMOUNT=10.00
PAYMENTS_MAX_AMOUNT=990.00

GIFTAPI_BASE_URL=https://sandbox.giftapi.io/api/v1/partner
GIFTAPI_TOKEN=your_giftapi_token
GIFTAPI_SECRET=your_giftapi_secret
GIFTAPI_LOCALE=ru

# ---- Rukassa: пополнение баланса (альтернатива NicePay) ----
# Если RUKASSA_SHOP_ID и RUKASSA_TOKEN заданы, Rukassa используется вместо NicePay.
# Rukassa поддерживает только RUB — установите PAYMENTS_CURRENCY=RUB.
# Webhook URL: {WEB_BASE_URL}/webhooks/rukassa — укажите в личном кабинете Rukassa.
RUKASSA_BASE_URL=https://lk.rukassa.io/api/v1
RUKASSA_SHOP_ID=
RUKASSA_TOKEN=
RUKASSA_SUCCESS_URL=
RUKASSA_FAIL_URL=
RUKASSA_WEBHOOK_PATH=/webhooks/rukassa

# ---- Курсы валют ----
# EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# EXCHANGE_RATE_CACHE_TTL=600
# FALLBACK_USDT_RUB_RATE=90.00

# ---- Вывод в USDT ----
# WITHDRAWAL_MIN_AMOUNT_USDT=10.00
# WITHDRAWAL_NETWORKS=TRC20,BEP20,ERC20

# ---- Web-приложение ----
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8088

# ---- Mini App (Cloudflare Tunnel) ----
# HTTPS URL публичного адреса веб-сервера.
# Заполняется автоматически лаунчером при старте Cloudflare Tunnel.
# Используется для: Telegram Mini App + NicePay webhook
# Webhook URL для NicePay: {WEB_BASE_URL}/webhooks/nicepay
WEB_BASE_URL=
# Username бота (без @), нужен для Telegram Login Widget
BOT_USERNAME=

# ---- Прокси / кастомный API (при блокировке Telegram) ----
# SOCKS5 или HTTP прокси для подключения к Telegram API
# TELEGRAM_PROXY=socks5://user:pass@host:port
# TELEGRAM_PROXY=http://host:port
TELEGRAM_PROXY=
# Кастомный URL Telegram Bot API (если запускаете локальный сервер)
# https://github.com/tdlib/telegram-bot-api
# TELEGRAM_API_URL=http://localhost:8081
TELEGRAM_API_URL=